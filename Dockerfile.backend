FROM python:3.11-slim

WORKDIR /app

# Patch OS packages that have fixes since the base image was built.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch first, in its own layer: the default Linux wheel bundles CUDA and adds
# gigabytes, and a separate layer keeps it cached when requirements change.
# The pip cache mount keeps downloaded wheels on the build machine between builds (it is
# not part of the image), so a changed requirements file only downloads what changed.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url https://download.pytorch.org/whl/cpu torch

COPY requirements-backend.txt .
# setuptools and wheel are build tools the app does not need at runtime; removing
# them also removes the vulnerable copies bundled with them.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-backend.txt \
    && pip uninstall -y setuptools wheel

# Bake the public embedding model into the image so the container starts offline.
ENV HF_HOME=/app/.cache/huggingface
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

COPY app ./app
COPY src/asa ./src/asa

ENV PYTHONPATH=/app/src

# Build the manual index into the image so it is self-contained (no host folder is
# needed on ECS/Fargate). Rebuild the image whenever the manuals change.
COPY aem_documents ./aem_documents
COPY scripts/ingest.py ./scripts/ingest.py
RUN python scripts/ingest.py \
    && rm -rf aem_documents scripts

# Run as a non-root user. A numeric UID lets Kubernetes verify runAsNonRoot. The app
# writes the audit log (/app/logs) and the Chroma index (/app/chroma_store), so it owns /app.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin app \
    && chown -R 10001:10001 /app
USER 10001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
