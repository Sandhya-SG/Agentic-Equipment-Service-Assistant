FROM python:3.11-slim

WORKDIR /app

# Patch OS packages that have fixes since the base image was built.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-frontend.txt .
# setuptools and wheel are build tools the app does not need at runtime; removing
# them also removes the vulnerable copies bundled with them.
RUN pip install --no-cache-dir -r requirements-frontend.txt \
    && pip uninstall -y setuptools wheel

COPY frontend ./frontend

# Run as a non-root user. A numeric UID lets Kubernetes verify runAsNonRoot.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin app \
    && chown -R 10001:10001 /app
USER 10001

EXPOSE 5000

# gunicorn, not Flask's development server. The frontend waits on the slow agent backend
# (up to BACKEND_TIMEOUT seconds), so use threads and a timeout above that.
# --no-control-socket: gunicorn 26 opens a control socket under $HOME by default. We do not use it,
# and the non-root user has no writable home, so it only logged "Permission denied: '/home/app'".
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--threads", "8", "--timeout", "150", "--no-control-socket", "frontend.app:app"]
