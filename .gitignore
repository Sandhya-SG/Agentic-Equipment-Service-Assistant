# Secrets — never commit
.env
**/.env

# Local environments and machine metadata
**/.venv/
**/__pycache__/
.DS_Store
**/.DS_Store

# Built / generated artifacts
logs/
chroma_store/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Real sponsor data — never commit
aem_documents/*
!aem_documents/.gitkeep

corpus/aem/*
!corpus/aem/.gitkeep
# Promptfoo
promptfoo-tests/node_modules/
promptfoo-tests/*-out.json
promptfoo-tests/out.json
promptfoo-tests/*-results.json
deepeval-tests/deepeval-results.json
deepeval-tests/.deepeval/
.deepeval/

# MLflow runs
mlruns/

# Estimated OpenAI spend ledger (see OPENAI_SPEND_CAP_USD)
.openai_spend.json

# Generated evaluation reports (the real answers of a live run)
eval/reports/

# MLflow tracking database written by scripts/log_to_mlflow.py (the runs themselves are in mlruns/, ignored above)
mlflow.db

# Dated DeepEval outputs (kept local, like the Promptfoo results above); the harness writes deepeval-results.json
deepeval-tests/deepeval-results*.json
