APP_NAME=Equipment Service Assistant
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5000
MODEL_PROVIDER=ollama
MODEL_NAME=llama3.1
# Local runs. docker-compose overrides this; set DOCKER_OLLAMA_BASE_URL to change the container value.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF=0.5
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

LANGFUSE_HOST=http://localhost:3000
BACKEND_URL=http://localhost:8000
OLLAMA_API_KEY=
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
#LANGFUSE_HOST="https://us.cloud.langfuse.com"
OPENAI_API_KEY=
# OpenAI call limits (all optional; these are the defaults). Retries use the SDK's exponential backoff on 429,
# 5xx and connection errors. A request that has used its token budget stops and is answered as "unavailable".
#OPENAI_TIMEOUT_S=60
#OPENAI_CONNECT_TIMEOUT_S=10
#OPENAI_MAX_RETRIES=2
#OPENAI_MAX_OUTPUT_TOKENS=2000
#OPENAI_REQUEST_TOKEN_BUDGET=60000
# Best-effort control, NOT a guaranteed financial limit: stop all calls once the ESTIMATED spend reaches this many
# dollars (ledger: OPENAI_SPEND_LEDGER, default .openai_spend.json). The estimate can be lower than the real bill. Covers
# the app and the evaluation scripts, not DeepEval or Promptfoo; set a limit in the OpenAI console too.
#OPENAI_SPEND_CAP_USD=0.55
# Per-client chat requests per minute (0 = off). Set TRUST_FORWARDED_FOR=true only when the backend is reachable
# through the frontend alone (the cluster does); otherwise a client could fake its address.
#RATE_LIMIT_PER_MINUTE=30
#TRUST_FORWARDED_FOR=false
# Signs the clarification state returned to the client so that ANY backend pod can continue a clarification
# (needed with more than one replica; the same value on every pod). Without it the state stays in one pod's memory.
#CLARIFICATION_SECRET=
# Human review (the /review page). The reviewer token is REQUIRED for the review API: without it the endpoints answer
# 503. Use a long random value and keep it secret. REVIEW_SAMPLE_RATE (0 to 1) also sends that share of ordinary
# answers to review as a quality check (0 = off). Run ONE backend replica while using the review queue.
#REVIEWER_TOKEN=
# Monitoring page (/monitor) and GET /api/monitoring. With a token set, callers must send it (X-Monitor-Token). With none,
# the endpoint is open only when ENVIRONMENT is development; in a deployed environment it answers 503. Use a long random
# value and keep it secret. LANGFUSE_URL (frontend, optional) adds a link to your Langfuse dashboard on the page.
#MONITOR_TOKEN=
#LANGFUSE_URL=
#REVIEW_SAMPLE_RATE=0
#CLARIFICATION_TTL_S=900
# Seconds the frontend waits for the agents (they search the manual and may retry).
BACKEND_TIMEOUT=120

# Langfuse tracing is off unless BOTH keys above are set.
# By default traces hold structure, timing, tokens and scores but NO question or answer text.
# Set to true to also keep text (it is PII-redacted and truncated first).
LANGFUSE_CAPTURE_CONTENT=false
# Optional: app version shown on every trace, to compare releases (e.g. the image's sha- tag).
#LANGFUSE_RELEASE=sha-abc1234
# Docker Compose reaches the host-side Langfuse here (the default is fine for docker-compose.langfuse.yml).
#DOCKER_LANGFUSE_HOST=http://host.docker.internal:3000
