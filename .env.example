APP_NAME=Equipment Service Assistant
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5000
MODEL_PROVIDER=ollama
MODEL_NAME=llama3.1
# Local runs. docker-compose overrides this; set DOCKER_OLLAMA_BASE_URL to change the container value.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF=0.5
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

LANGFUSE_HOST=http://localhost:3000
BACKEND_URL=http://localhost:8000
OLLAMA_API_KEY=
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
#LANGFUSE_HOST="https://us.cloud.langfuse.com"
OPENAI_API_KEY=

# Langfuse tracing turns on when both keys above are set. Spans never include user text
# unless this is true; text is redacted and truncated first. Keep false if questions can contain personal data.
LANGFUSE_CAPTURE_CONTENT=false
